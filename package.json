{
  "name": "dsh-research-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Research Control Plane V1 plugin: a Git-backed, event-sourced research-workflow Cockpit for DeepSeek Harness (Project/Topic/Workstream + History/Current/Future + immutable Agent PlanFork + Intervention attention plane + read-only Investigator)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "schema",
    "SNAPSHOT.md",
    "cordis.patch.yml",
    "ARCHITECTURE.md",
    "DOMAIN_SCHEMA.md",
    "DSH_ADAPTER.md",
    "GIT_INTEGRATION.md",
    "HISTORY_EVENT_CATALOG.md",
    "PLAN_FORK_SPEC.md",
    "SUBAGENT_ROUTING.md",
    "TEST_MATRIX.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/snapshot-release.mjs",
    "test": "vitest run",
    "lint": "node scripts/check-imports.mjs",
    "test:e2e": "bash scripts/e2e-run.sh",
    "test:e2e:playwright": "playwright test --config e2e/playwright.config.ts",
    "test:perf": "vitest run --config tests/perf/vitest.perf.config.ts",
    "pack:verify": "node scripts/pack-verify.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "fast-check": "^4.9.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
