{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-research-control.invalid/schema/declarative/objectives.schema.json",
  "title": ".research/objectives.yaml",
  "type": "object",
  "required": ["objectives"],
  "additionalProperties": false,
  "properties": {
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scope", "statement", "success_criteria", "created_at"],
        "if": { "properties": { "scope": { "const": "TOPIC" } } },
        "then": { "required": ["topic_id"] },
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "../common.schema.json#/$defs/idObjective" },
          "scope": { "enum": ["PROJECT", "TOPIC"] },
          "topic_id": { "$ref": "../common.schema.json#/$defs/idTopic" },
          "statement": { "type": "string", "minLength": 1 },
          "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["ACTIVE", "ACHIEVED", "DROPPED"], "default": "ACTIVE" },
          "target_date": { "$ref": "../common.schema.json#/$defs/isoDate" },
          "priority": { "enum": ["P0", "P1", "P2", "P3"], "default": "P2" },
          "linked_refs": {
            "type": "array", "default": [],
            "items": {
              "allOf": [{ "$ref": "../common.schema.json#/$defs/typedRef" }],
              "properties": { "kind": { "enum": ["GATE", "MILESTONE", "WORKSTREAM"] } }
            }
          },
          "created_at": { "$ref": "../common.schema.json#/$defs/isoTimestamp" }
        }
      }
    }
  }
}
